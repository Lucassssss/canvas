    "vercel-minimax-ai-provider": "^0.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
