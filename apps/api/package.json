    "@ai-sdk/deepseek": "^2.0.24",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@browserbasehq/stagehand": "^3.1.0",
    "@langchain/core": "^1.1.31",
    "@langchain/deepseek": "^1.0.16",
    "@langchain/langgraph": "^1.2.1",
    "@langchain/openai": "^1.2.12",
    "@openrouter/ai-sdk-provider": "^2.3.1",
    "ai": "^6.0.141",
    "bash-tool": "^1.3.15",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "deepagents": "^1.8.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "just-bash": "^2.12.8",
    "kill-port": "^2.0.1",
    "langchain": "^1.2.30",
    "nanoid": "^5.1.7",
    "nodemailer": "^8.0.2",
    "openai": "^6.27.0",
