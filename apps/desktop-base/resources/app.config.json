{
  "appName": "浆果浏览器",
  "appId": "cc.joii.browser",
  "window": {
    "width": 1280,
    "height": 800,
    "minWidth": 800,
    "minHeight": 600,
    "titleBarStyle": "hidden"
  },
  "dev": {
    "enabled": true,
    "webUrl": "http://localhost:4000",
    "skipServers": false
  },
  "servers": [
    {
      "id": "api",
      "resource": "jbrowser-server",
      "port": 4003,
      "healthPath": "/health",
      "startupTimeoutMs": 15000,
      "autoStart": true,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ],
  "update": {
    "enabled": false,
    "manifestUrl": "https://cdn.example.com/manifest.json",
    "checkIntervalMs": 3600000
  }
}